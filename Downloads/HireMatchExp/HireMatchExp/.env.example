# HireMatch Environment Configuration Template

# Application
HIREMATCH_APP_NAME="HireMatch"
HIREMATCH_APP_VERSION="0.1.0-alpha"
HIREMATCH_DEBUG=False
HIREMATCH_LOG_LEVEL="INFO"

# Storage & Database
HIREMATCH_DB_PATH="data/hirematch.db"
HIREMATCH_STORAGE_DIR="data/storage"
HIREMATCH_CACHE_DIR="data/cache/models"
HIREMATCH_TEMP_DIR="data/temp"

# Session & Upload Limits
HIREMATCH_MAX_RESUMES_PER_SESSION=100
HIREMATCH_MAX_FILE_SIZE_BYTES=10485760       # 10 MB per resume
HIREMATCH_MAX_TOTAL_UPLOAD_SIZE_BYTES=209715200 # 200 MB total per upload batch
HIREMATCH_PROCESSING_BATCH_SIZE=10           # Resumes processed per batch chunk

# NLP Model Defaults
HIREMATCH_SEMANTIC_MODEL="sentence-transformers/all-MiniLM-L6-v2"
HIREMATCH_SPACY_MODEL="en_core_web_sm"
